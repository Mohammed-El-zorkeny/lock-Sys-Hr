                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const res = pm.response.json();",
                                    "",
                                    "if (res.status === 'success') {",
                                    "    pm.collectionVariables.set('token', res.token);",
                                    "    pm.collectionVariables.set('company_id', res.user.defaultCompanyId);",
                                    "    pm.collectionVariables.set('branch_id', res.user.defaultBranchId);",
                                    "    console.log('✅ Token saved:', res.token);",
                                    "    console.log('🏢 Company ID:', res.user.defaultCompanyId);",
                                    "    console.log('🏬 Branch ID:', res.user.defaultBranchId);",
                                    "} else {",
                                    "    console.error('❌ Login failed:', res.messageEn);",
                                    "}"
